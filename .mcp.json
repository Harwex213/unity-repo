{
  "mcpServers": {
    "unity-ostrov": {
      "command": "${HOME}/.unity/bin/unity",
      "args": [
        "mcp",
        "--project-path",
        "${HOME}/Projects/unity-repo/projects/Ostrov"
      ],
      "env": {}
    },
    "unity-gameshow": {
      "command": "${HOME}/.unity/bin/unity",
      "args": [
        "mcp",
        "--project-path",
        "${HOME}/Projects/unity-repo/projects/GameShow_v4"
      ],
      "env": {}
    },
    "unity-selflearning": {
      "command": "${HOME}/.unity/bin/unity",
      "args": [
        "mcp",
        "--project-path",
        "${HOME}/Projects/unity-repo/projects/SelfLearning"
      ],
      "env": {}
    },
    "remote-imagegen": {
      "command": "node",
      "args": ["./javascript/imagen-mcp/node_modules/remote-imagegen-mcp/dist/main.js"],
      "env": {
        "REMOTE_IMAGEGEN_TOKEN": "${REMOTE_IMAGEGEN_TOKEN}"
      }
    }
  }
}
