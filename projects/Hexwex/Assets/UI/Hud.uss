/* The HUD of the island scene. Built by Hexwex.View.Hud. */

.hud {
    flex-grow: 1;
    flex-direction: column;
    color: rgb(236, 232, 220);
    font-size: 20px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Top bar */

.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 18px;
    background-color: rgba(20, 24, 30, 0.86);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
}

.resources {
    flex-direction: row;
    align-items: center;
}

.chip {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
    padding: 4px 10px 4px 6px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 8px;
}

.chip-icon {
    width: 34px;
    height: 34px;
    margin-right: 6px;
}

.chip-value {
    font-size: 22px;
    -unity-font-style: bold;
}

.negative {
    color: rgb(255, 122, 122);
}

.status {
    flex-direction: row;
    align-items: center;
}

.meter {
    width: 380px;
    margin-right: 18px;
}

.meter-label {
    font-size: 18px;
}

.meter-bar {
    height: 10px;
    margin-top: 4px;
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    background-color: rgb(120, 200, 120);
}

.meter-fill.level-1 {
    background-color: rgb(222, 200, 90);
}

.meter-fill.level-2 {
    background-color: rgb(230, 140, 70);
}

.meter-fill.level-3 {
    background-color: rgb(196, 80, 200);
}

.turn {
    margin-left: 18px;
    font-size: 22px;
    -unity-font-style: bold;
}

/* Middle: players on the left, the hex panel on the right */

.middle {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 14px 18px;
}

.players {
    width: 330px;
    padding: 10px;
    background-color: rgba(20, 24, 30, 0.8);
    border-radius: 10px;
}

.player {
    flex-direction: row;
    align-items: center;
    padding: 6px 4px;
}

.player.eliminated {
    opacity: 0.4;
}

.swatch {
    width: 12px;
    height: 40px;
    margin-right: 10px;
    border-radius: 3px;
}

.player-name {
    font-size: 20px;
    -unity-font-style: bold;
}

.player-meta {
    font-size: 16px;
    color: rgb(170, 172, 168);
}

.hex-panel {
    width: 400px;
    padding: 14px;
    background-color: rgba(20, 24, 30, 0.88);
    border-radius: 10px;
}

.panel-title {
    font-size: 26px;
    -unity-font-style: bold;
}

.panel-subtitle {
    font-size: 22px;
    -unity-font-style: bold;
}

.panel-text {
    margin-top: 6px;
    font-size: 18px;
    white-space: normal;
    color: rgb(200, 200, 192);
}

.toxic {
    color: rgb(214, 140, 232);
}

.good {
    color: rgb(150, 220, 130);
}

.bad {
    color: rgb(255, 130, 120);
}

.face {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 0 0;
    padding: 6px 8px;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    color: rgb(236, 232, 220);
}

.face:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.face.static:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.face.chosen {
    border-color: rgb(255, 214, 110);
    background-color: rgba(255, 214, 110, 0.16);
}

.face.refused {
    opacity: 0.45;
}

.face-icon {
    width: 28px;
    height: 28px;
    margin-right: 6px;
}

.face-amount {
    margin-right: 12px;
    font-size: 20px;
    -unity-font-style: bold;
}

.face-toxicity {
    margin-right: 12px;
    font-size: 18px;
    color: rgb(214, 140, 232);
}

.face-note {
    flex-grow: 1;
    -unity-text-align: middle-right;
    font-size: 16px;
    color: rgb(170, 172, 168);
}

.suggestion {
    margin-top: 4px;
}

/* Bottom bar */

.bottom-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 12px 18px;
    background-color: rgba(20, 24, 30, 0.86);
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0.5);
}

.hint {
    flex-grow: 1;
    font-size: 20px;
    color: rgb(214, 210, 196);
}

.cards {
    flex-grow: 1;
    flex-direction: row;
}

.card {
    width: 150px;
    margin: 0 8px 0 0;
    padding: 8px;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
    color: rgb(236, 232, 220);
}

.card:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.card.armed {
    border-color: rgb(255, 214, 110);
    background-color: rgba(255, 214, 110, 0.2);
}

.card.poor {
    opacity: 0.5;
}

.card-icon {
    width: 56px;
    height: 56px;
    margin-right: 6px;
}

.card-label {
    font-size: 17px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.cost-icon {
    width: 22px;
    height: 22px;
}

.cost-value {
    margin: 0 6px 0 2px;
    font-size: 17px;
}

.tools {
    margin: 0 14px;
}

.small-button {
    margin: 3px 6px;
    padding: 8px 14px;
    font-size: 18px;
    color: rgb(236, 232, 220);
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
}

.small-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.small-button.armed {
    border-color: rgb(255, 120, 100);
    background-color: rgba(255, 120, 100, 0.22);
}

.end-button {
    margin: 0 0 0 10px;
    padding: 14px 26px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(28, 26, 18);
    background-color: rgb(236, 196, 92);
    border-width: 0;
    border-radius: 8px;
}

.end-button:hover {
    background-color: rgb(250, 216, 122);
}

.end-button:disabled {
    opacity: 0.45;
}

.seed-field {
    width: 240px;
    margin-right: 6px;
    font-size: 20px;
}

/* Notice and the plates above the hexes */

.notice {
    position: absolute;
    top: 96px;
    align-self: center;
    padding: 10px 22px;
    font-size: 22px;
    color: rgb(255, 244, 214);
    background-color: rgba(40, 30, 20, 0.92);
    border-radius: 8px;
}

.plates {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.plate {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 3px 8px;
    translate: -50% -100%;
    background-color: rgba(20, 24, 30, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 6px;
}

.plate.changed {
    border-color: rgb(255, 214, 110);
}

.plate-icon {
    width: 26px;
    height: 26px;
    margin-right: 3px;
}

.plate-amount {
    margin-right: 6px;
    font-size: 20px;
    -unity-font-style: bold;
}

.plate-toxicity {
    font-size: 17px;
    color: rgb(214, 140, 232);
}

/* Modals */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 8, 12, 0.66);
}

.modal {
    width: 620px;
    padding: 26px;
    align-items: center;
    background-color: rgb(28, 32, 40);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 12px;
}

.modal.wide {
    width: 820px;
    max-height: 86%;
}

.modal .end-button {
    margin: 20px 0 0 0;
}

.modal-title {
    margin: 8px 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.reels {
    flex-direction: row;
    margin: 14px 0;
}

.reel {
    width: 110px;
    height: 110px;
    margin: 0 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 3px;
    border-color: rgb(120, 200, 120);
    border-radius: 10px;
}

.reel.bad {
    border-color: rgb(196, 80, 200);
}

.reel-icon {
    width: 80px;
    height: 80px;
}

.tech-list {
    align-self: stretch;
    flex-grow: 1;
}

.tech {
    margin: 3px 0;
    padding: 8px 12px;
    align-items: stretch;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    color: rgb(236, 232, 220);
}

.tech.available {
    border-color: rgba(236, 196, 92, 0.7);
}

.tech.available:hover {
    background-color: rgba(236, 196, 92, 0.18);
}

.tech.owned {
    border-color: rgba(120, 200, 120, 0.7);
    opacity: 1;
}

.tech.locked {
    opacity: 0.5;
}

.seed-field .unity-text-field__input {
    color: rgb(24, 24, 24);
    background-color: rgb(236, 232, 220);
}

/* The cell panel of the global map */

.cell-buttons {
    margin-top: 10px;
    flex-wrap: wrap;
}

.small-button:disabled {
    opacity: 0.45;
}

.player-body {
    flex-shrink: 1;
}

/* The battle bar: the long hint gives way, the controls keep their size. */

.bottom-bar .chip,
.bottom-bar .small-button {
    flex-shrink: 0;
}

.bottom-bar .hint {
    flex-shrink: 1;
    white-space: normal;
}

/* A row of the players panel is a button: it opens that player's island. */

.players .player {
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    color: rgb(236, 232, 220);
    -unity-text-align: middle-left;
}

.players .player:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.players .player.viewed {
    border-color: rgb(226, 190, 104);
    background-color: rgba(226, 190, 104, 0.14);
}

.players .player:disabled {
    opacity: 1;
}

.players .player.eliminated {
    opacity: 0.4;
}

.player-name,
.player-meta {
    -unity-text-align: middle-left;
}

/* What flies: the motes of the tax collection and the numbers of a hit. */

.flight {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 3px 9px 3px 5px;
    translate: -50% -50%;
    background-color: rgba(20, 24, 30, 0.9);
    border-width: 2px;
    border-color: rgb(236, 196, 92);
    border-radius: 14px;
}

.flight.toxic {
    border-color: rgb(196, 80, 200);
}

.flight.toxic .plate-amount {
    color: rgb(214, 140, 232);
}

.floater {
    position: absolute;
    translate: -50% -50%;
    font-size: 22px;
    -unity-font-style: bold;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.9);
}

.floater.good {
    color: rgb(250, 244, 220);
}

/* The slot: a reel in motion has no verdict yet. */

.reel.spinning {
    border-color: rgba(255, 255, 255, 0.35);
}

.slot-result {
    align-items: center;
    align-self: stretch;
}

/* A long zone name must not run under the buttons beside the meter. */

.meter .row {
    overflow: hidden;
}

.meter-label {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
