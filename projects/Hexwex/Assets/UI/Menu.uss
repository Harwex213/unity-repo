/* The main menu, after the menus of Warcraft III. Built by Hexwex.View.MainMenu, over the HUD. */

.main-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(236, 232, 220);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}

/* The menu comes in as the prototype's does: it fades up over the painting. */
.main-menu.entering {
    opacity: 0;
}

/* A start fades the menu out over the freshly created game. */
.main-menu.leaving {
    transition-duration: 0.7s;
    transition-timing-function: ease-in;
    opacity: 0;
}

/* The island turns behind the menu, under a dark shade. */
.main-menu__shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 6, 14, 0.84);
}

/* The painting carries its own shade; the plain one stays for when it is missing. */
.main-menu.painted .main-menu__shade {
    background-color: rgba(0, 0, 0, 0);
}

/* Two dark bands with a gold line, as in a cutscene. */
.main-menu__band {
    position: absolute;
    left: 0;
    right: 0;
    height: 64px;
    background-color: rgb(3, 4, 7);
    border-color: rgba(190, 150, 70, 0.75);
}

.main-menu__band--top {
    top: 0;
    border-bottom-width: 2px;
}

.main-menu__band--bottom {
    bottom: 0;
    border-top-width: 2px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-right: 40px;
}

.main-menu__version {
    font-size: 18px;
    letter-spacing: 2px;
    color: rgba(226, 190, 104, 0.7);
}

.main-menu__layout {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 110px;
}

.main-menu__layout:disabled {
    opacity: 0.35;
}

/* The title block, on the left */

.main-menu__title-block {
    width: 800px;
    align-items: flex-start;
    transition-property: translate, opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}

/* The title slides in from the left as the menu opens. */
.main-menu.entering .main-menu__title-block {
    translate: -60px 0;
    opacity: 0;
}

.main-menu__heading {
    margin-left: 14px;
    font-size: 24px;
    letter-spacing: 6px;
    color: rgb(226, 190, 104);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

/* The logo is 1792 by 512. */
.main-menu__logo {
    width: 800px;
    height: 229px;
    margin: -14px 0 -22px -18px;
    -unity-background-scale-mode: scale-to-fit;
}

.main-menu__subtitle {
    margin-left: 14px;
    font-size: 30px;
    -unity-font-style: italic;
    color: rgb(214, 210, 196);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}

.main-menu-bar {
    flex-direction: row;
    align-items: center;
    margin: 44px 0 0 14px;
    padding: 10px 14px;
    background-color: rgba(12, 16, 30, 0.9);
    border-width: 2px;
    border-color: rgb(122, 94, 42);
    border-radius: 4px;
}

.main-menu-bar__label {
    margin-right: 10px;
    font-size: 20px;
    color: rgb(226, 190, 104);
}

.main-menu-bar__select {
    width: 190px;
    font-size: 20px;
}

.main-menu-bar__button {
    width: 52px;
    height: 52px;
    margin: 0 0 0 14px;
    padding: 4px;
    background-color: rgb(22, 32, 60);
    border-width: 2px;
    border-color: rgb(122, 94, 42);
    border-radius: 4px;
}

.main-menu-bar__button:hover {
    background-color: rgb(40, 58, 104);
    border-color: rgb(244, 212, 124);
}

.main-menu-bar__icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

/* The slab on its chains, on the right */

.main-menu__hang {
    width: 560px;
    align-self: stretch;
    transition-property: translate;
    transition-duration: 1.1s;
    transition-timing-function: ease-out-back;
}

/* The slab drops on its chains as the menu opens, and settles with a little swing. */
.main-menu.entering .main-menu__hang {
    translate: 0 -140px;
}

.main-menu__chains {
    flex-grow: 1;
    min-height: 90px;
    flex-direction: row;
    justify-content: space-between;
    padding: 0 86px;
}

.main-menu__chain {
    width: 30px;
}

/* What is left under the slab: a little more than above, so the slab hangs just over the middle. */
.main-menu__hang-rest {
    flex-grow: 1.25;
}

/* The frame: dark iron outside, gold inside it. */
.main-menu__panel {
    padding: 5px;
    background-color: rgb(42, 34, 22);
    border-width: 3px;
    border-color: rgb(10, 9, 8);
    border-radius: 6px;
}

.main-menu__panel-inner {
    padding: 44px 26px 22px 26px;
    background-color: rgba(11, 15, 30, 0.97);
    border-width: 2px;
    border-top-color: rgb(244, 212, 124);
    border-left-color: rgb(226, 190, 104);
    border-right-color: rgb(150, 116, 52);
    border-bottom-color: rgb(122, 94, 42);
    border-radius: 3px;
    align-items: stretch;
}

/* The emblem sits astride the top of the frame, where the chains come down. */
.main-menu__crest {
    position: absolute;
    left: 50%;
    top: -52px;
    width: 104px;
    height: 104px;
    translate: -50% 0;
    -unity-background-scale-mode: scale-to-fit;
}

.main-menu__stud {
    position: absolute;
    width: 18px;
    height: 18px;
}

.main-menu__stud--top-left {
    left: 6px;
    top: 6px;
}

.main-menu__stud--top-right {
    right: 6px;
    top: 6px;
}

.main-menu__stud--bottom-left {
    left: 6px;
    bottom: 6px;
}

.main-menu__stud--bottom-right {
    right: 6px;
    bottom: 6px;
}

.main-menu__panel-title {
    font-size: 26px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(244, 212, 124);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
}

.main-menu__rule {
    height: 2px;
    margin: 12px 24px;
    background-color: rgba(190, 150, 70, 0.55);
}

/* An entry: a blue plate in a gold rim, lit from above. */
.main-menu-entry {
    flex-direction: row;
    align-items: center;
    margin: 6px 0;
    padding: 9px 14px;
    background-color: rgb(20, 29, 56);
    border-width: 2px;
    border-top-color: rgb(176, 138, 64);
    border-left-color: rgb(150, 116, 52);
    border-right-color: rgb(96, 74, 34);
    border-bottom-color: rgb(78, 60, 28);
    border-radius: 3px;
    color: rgb(236, 232, 220);
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.main-menu-entry--active {
    background-color: rgb(38, 56, 104);
    border-top-color: rgb(255, 236, 170);
    border-left-color: rgb(250, 222, 140);
    border-right-color: rgb(226, 190, 104);
    border-bottom-color: rgb(206, 168, 86);
}

.main-menu-entry:active {
    background-color: rgb(14, 20, 40);
}

.main-menu-entry__frame {
    width: 62px;
    height: 62px;
    margin-right: 16px;
    padding: 5px;
    background-color: rgb(6, 8, 16);
    border-width: 2px;
    border-color: rgb(150, 116, 52);
    border-radius: 3px;
}

.main-menu-entry--active .main-menu-entry__frame {
    border-color: rgb(250, 222, 140);
}

.main-menu-entry__icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.main-menu-entry__label {
    font-size: 17px;
    letter-spacing: 3px;
    color: rgb(190, 156, 84);
}

.main-menu-entry__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(244, 222, 160);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.9);
}

.main-menu-entry--active .main-menu-entry__label {
    color: rgb(244, 212, 124);
}

.main-menu-entry--active .main-menu-entry__title {
    color: rgb(255, 248, 222);
}

/* A plain plate: the exit at the foot of the slab, and the close of a window. */
.main-menu-button {
    margin: 0;
    padding: 10px 34px;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(244, 222, 160);
    background-color: rgb(20, 29, 56);
    border-width: 2px;
    border-top-color: rgb(176, 138, 64);
    border-left-color: rgb(150, 116, 52);
    border-right-color: rgb(96, 74, 34);
    border-bottom-color: rgb(78, 60, 28);
    border-radius: 3px;
}

.main-menu-button:hover {
    color: rgb(255, 248, 222);
    background-color: rgb(38, 56, 104);
    border-color: rgb(250, 222, 140);
}

.main-menu-button--exit {
    align-self: center;
    width: 260px;
}

/* The credits */

.main-menu-credits {
    width: 560px;
}

.main-menu-credits__row {
    flex-direction: row;
    justify-content: space-between;
    align-self: stretch;
    margin: 6px 0;
}

.main-menu-credits__role {
    font-size: 20px;
    color: rgb(170, 172, 168);
}

.main-menu-credits__name {
    font-size: 20px;
    -unity-font-style: bold;
}

.main-menu-credits .main-menu-button {
    margin-top: 20px;
}

.main-menu-bar__select .unity-base-popup-field__input {
    color: rgb(24, 24, 24);
    background-color: rgb(236, 232, 220);
}

/* A button centres its text; the two lines of an entry start at the left. */
.main-menu-entry__label,
.main-menu-entry__title {
    -unity-text-align: middle-left;
}
