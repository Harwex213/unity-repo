{
  "name": "design-docs",
  "private": true,
  "version": "1.0.0",
  "description": "Design documents viewer: document list and a canvas with zoom and pan",
  "type": "module",
  "browserslist": [
    "last 1 version",
    "> 1%",
    "not dead"
  ],
  "scripts": {
    "dev": "rspack serve",
    "build": "rspack build",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-doc.mjs",
    "check:all": "node scripts/check-isolation.mjs && tsc --noEmit",
    "snapshot": "node scripts/snapshot.mjs",
    "new-doc": "node scripts/new-doc.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.1.4",
    "@rspack/core": "2.1.4",
    "@rspack/dev-server": "2.1.0",
    "@types/node": "24.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}
